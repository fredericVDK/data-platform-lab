# Kopieer naar .env en vul sterke wachtwoorden in:  cp .env.example .env
# .env komt NOOIT in Git (staat in .gitignore). Bewaar een kopie in je wachtwoordmanager:
# zonder deze wachtwoorden is een restore op een nieuwe server veel lastiger.
POSTGRES_PASSWORD=wijzig-mij-admin
ETL_WRITER_PASSWORD=wijzig-mij-etl
BI_READER_PASSWORD=wijzig-mij-bi

# Optioneel (profiel "monitoring")
GRAFANA_ADMIN_PASSWORD=wijzig-mij-grafana

# ---- back-ups (infra/backup.sh) ----
BACKUP_DIR=/home/andre/backups/postgres
BACKUP_KEEP_DAYS=7
# Tweede schijf: map moet een leeg bestand .backup-target bevatten (bewijs dat de schijf gekoppeld is)
BACKUP_COPY_DIR=
BACKUP_COPY_KEEP_DAYS=30
# Cloud via rclone, bv. "b2crypt:steelline-backups" (leeg = overslaan)
RCLONE_REMOTE=
RCLONE_KEEP_DAYS=30
# Uptime Kuma push-monitor, ZONDER "?status=up&msg=OK&ping=", bv. http://127.0.0.1:3001/api/push/AbC123
KUMA_PUSH_URL=

# ---- nachtelijke pipeline (infra/pipeline) ----
# Uptime Kuma push-monitor voor de ETL, host = containernaam, bv. http://uptime-kuma:3001/api/push/XyZ789
ETL_KUMA_PUSH_URL=
# hoeveel dagen terug de generator gemiste dagen inhaalt
INHAAL_DAGEN=7
# UID/GID van je gebruiker op de server (id -u / id -g), zodat de data van jou is
PIPELINE_UID=1000
PIPELINE_GID=1000
