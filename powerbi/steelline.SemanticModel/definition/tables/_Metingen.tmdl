	measure 'Rollen' = SUM ( OEE[rollen] )
		formatString: #,0
		displayFolder: Basis
		lineageTag: 1896f49f-f410-5249-906c-aaeff7428b41

	measure 'Rollen defect' = SUM ( OEE[rollen_defect] )
		formatString: #,0
		displayFolder: Basis
		lineageTag: f6d16008-453a-5989-a9dd-9f492d32c71d

	measure 'Beschikbaarheid' = DIVIDE ( [Looptijd (min)], [Geplande tijd (min)] )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: 1e72483f-d7b8-57f1-85e9-1388ade2ba65

	measure 'Prestatie' =
			VAR _loop = [Looptijd (min)]
			RETURN
			    IF ( _loop > 0, MIN ( DIVIDE ( [Ideale tijd (min)], _loop ), 1 ) )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: 4d0dedfd-2327-58a5-9583-45d8bdd7f881

	measure 'Kwaliteit' = DIVIDE ( [Ton goed], [Ton] )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: d24277be-a779-563a-ba02-edf35aba6e30

	measure 'OEE' =
			VAR _gepland = [Geplande tijd (min)]
			VAR _loop    = [Looptijd (min)]
			RETURN
			    IF (
			        _gepland > 0,
			        DIVIDE ( _loop, _gepland )
			            * IF ( _loop > 0, MIN ( DIVIDE ( [Ideale tijd (min)], _loop ), 1 ), 0 )
			            * COALESCE ( DIVIDE ( [Ton goed], [Ton] ), 1 )
			    )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: f1b5ceb6-d60e-5752-b6ed-96b9428c86ee

	measure 'Uitval %' = DIVIDE ( [Rollen defect], [Rollen] )
		formatString: 0.00%
		displayFolder: OEE
		lineageTag: 6124361b-4766-5ae1-8c16-2f67e045b911

	measure 'Storingen' =
			CALCULATE (
			    SUM ( Stilstand[aantal] ),
			    Stilstand[planned] = FALSE (),
			    Stilstandoorzaak[categorie] IN { "mechanisch", "elektrisch" }
			)
		formatString: #,0
		displayFolder: Betrouwbaarheid
		lineageTag: ff02c0cf-be0b-5548-be88-ec5af8c41242

	measure 'Storingsduur (min)' =
			CALCULATE (
			    SUM ( Stilstand[minuten] ),
			    Stilstand[planned] = FALSE (),
			    Stilstandoorzaak[categorie] IN { "mechanisch", "elektrisch" }
			)
		formatString: #,0
		displayFolder: Betrouwbaarheid
		lineageTag: 11bf101f-b4dd-5d49-9dbd-a1f70847a9cd

	measure 'Stilstand ongepland (min)' = SUM ( OEE[ongepland_min] )
		formatString: #,0
		displayFolder: Betrouwbaarheid
		lineageTag: 04b8a65c-50cc-55a4-9806-1400f6dedcde

	measure 'MTTR (min)' = DIVIDE ( [Storingsduur (min)], [Storingen] )
		formatString: #,0.0
		displayFolder: Betrouwbaarheid
		lineageTag: 8533daff-659f-5ff2-bb03-672e59c663bc

	measure 'MTBF (min)' = DIVIDE ( [Looptijd (min)], [Storingen] )
		formatString: #,0
		displayFolder: Betrouwbaarheid
		lineageTag: 93c85410-7a09-5d71-91a5-326f8ba2bcab

	measure 'Stilstand (min)' = SUM ( Stilstand[minuten] )
